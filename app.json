{
  "expo": {
    "name": "Asistix",
    "slug": "asistix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1565C0",
      "image": "./assets/icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asistix.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1565C0",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.asistix.app"
    },
    "web": {
      "favicon": "./assets/icon.svg"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1565C0"
        }
      ],
      "expo-font",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "9c49024d-9a27-4550-9777-7f2cf53518d3"
      }
    },
    "owner": "cosmefl"
  }
}
